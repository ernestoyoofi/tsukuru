"use client";

import { useEffect, useRef, useState } from "react";

const LANGUAGE_NAMES = {
  js: "JavaScript",
  jsx: "JavaScript",
  ts: "TypeScript",
  tsx: "TypeScript",
  bash: "Bash",
  sh: "Shell",
  shell: "Shell",
  json: "JSON",
  yaml: "YAML",
  yml: "YAML",
  html: "HTML",
  xml: "XML",
  css: "CSS",
  python: "Python",
  py: "Python",
  md: "Markdown",
  mdx: "MDX",
  diff: "Diff",
  text: "Text",
  plaintext: "Text",
  plain: "Text",
};

const COLLAPSED_HEIGHT = 320;

function prettyName(lang) {
  if (!lang) return "Text";
  const key = String(lang).toLowerCase();
  if (LANGUAGE_NAMES[key]) return LANGUAGE_NAMES[key];
  return key.charAt(0).toUpperCase() + key.slice(1);
}

async function copyText(text) {
  if (navigator?.clipboard?.writeText) {
    await navigator.clipboard.writeText(text);
    return;
  }
  const area = document.createElement("textarea");
  area.value = text;
  area.style.position = "fixed";
  area.style.opacity = "0";
  document.body.appendChild(area);
  area.select();
  document.execCommand("copy");
  document.body.removeChild(area);
}

export default function MDX_Component_CodeBlock({
  language = "",
  children = null,
}) {
  const preRef = useRef(null);
  const timerRef = useRef(null);
  const [copied, setCopied] = useState(false);
  const [expanded, setExpanded] = useState(false);
  const [tall, setTall] = useState(false);

  useEffect(() => {
    if (preRef.current && preRef.current.scrollHeight > COLLAPSED_HEIGHT + 40) {
      setTall(true);
    }
    return () => {
      if (timerRef.current) clearTimeout(timerRef.current);
    };
  }, []);

  const onCopy = async () => {
    try {
      const text = preRef.current?.innerText ?? "";
      await copyText(text);
      setCopied(true);
      if (timerRef.current) clearTimeout(timerRef.current);
      timerRef.current = setTimeout(() => setCopied(false), 1500);
    } catch {
      setCopied(false);
    }
  };

  const showAll = expanded || !tall;

  return (
    <div className="mt-4 min-w-0 max-w-full overflow-hidden rounded-xl border border-zinc-200">
      <div className="flex items-center justify-between gap-2 border-b border-zinc-200 bg-zinc-100 px-4 py-2">
        <span className="flex items-center gap-2 text-xs font-medium text-zinc-500">
          <span className="h-2.5 w-2.5 rounded-full bg-zinc-300" />
          {prettyName(language)}
        </span>
        <button
          type="button"
          onClick={onCopy}
          className="rounded-md px-2 py-1 text-xs font-medium text-zinc-500 hover:bg-zinc-200 hover:text-zinc-900"
        >
          {copied ? "Copied" : "Copy"}
        </button>
      </div>
      <div className="relative">
        <div
          className="max-w-full bg-zinc-50"
          style={{
            maxWidth: "100%",
            overflowX: "auto",
            overflowY: showAll ? "visible" : "hidden",
            ...(showAll ? {} : { maxHeight: COLLAPSED_HEIGHT }),
          }}
        >
          <pre
            ref={preRef}
            className="bg-zinc-50 p-4 text-sm leading-relaxed text-zinc-900 [&_code]:bg-transparent [&_code]:p-0 [&_code]:text-inherit"
            style={{ width: "max-content", minWidth: "100%", margin: 0 }}
          >
            {children}
          </pre>
        </div>
        {tall && !expanded && (
          <div className="absolute inset-x-0 bottom-0 bg-gradient-to-t from-zinc-50 via-zinc-50 to-transparent px-4 pt-10 pb-3 text-center">
            <button
              type="button"
              onClick={() => setExpanded(true)}
              className="rounded-full border border-zinc-300 bg-white px-4 py-1.5 text-xs font-medium text-zinc-700 shadow-sm hover:border-zinc-400 hover:text-zinc-950"
            >
              Show more
            </button>
          </div>
        )}
      </div>
      {tall && expanded && (
        <div className="border-t border-zinc-200 px-4 py-2 text-center">
          <button
            type="button"
            onClick={() => setExpanded(false)}
            className="rounded-md px-2 py-1 text-xs font-medium text-zinc-500 hover:bg-zinc-200 hover:text-zinc-900"
          >
            Show less
          </button>
        </div>
      )}
    </div>
  );
}
